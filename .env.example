# Optional exact Tailscale Serve hostname (no scheme or path).
# Prefer exporting this in your shell when running Astro through Tailscale.
TAILSCALE_HOSTNAME=

# Optional directory containing site.json, content/, assets/, and public/.
# Relative paths resolve from this builder's root. Shell/devenv values win.
# Leave blank to keep using the content currently in this repository.
SITE_DATA_DIR=
