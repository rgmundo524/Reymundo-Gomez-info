---
import { getCollection, getEntry, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Portrait from '../components/Portrait.astro';
import { contactLink, isVisible, pageProfile, selected } from '../lib/content';

const home = await getEntry('pages', 'home');
const page = home && isVisible(home) ? home : undefined;
const profile = await pageProfile(page);
const intro = page ? await render(page) : undefined;
const Intro = intro?.Content;
const contact = contactLink(profile);
const expertise = page ? await selected('expertise', page.data.expertise) : [];
const experience = page ? await selected('experience', page.data.experience) : [];
const projects = page ? await selected('projects', page.data.projects) : [];
const visiblePages = await getCollection('pages', isVisible);
const hasPage = (id: string) => visiblePages.some((entry) => entry.id === id);
---
<SiteLayout title={page?.data.title ?? 'Site in preparation'} description={page?.data.description_short ?? 'A personal website in preparation.'} profile={profile}>
  {page && profile ? <>
    <section class="container hero">
      <div class="hero-copy">
        <p class="eyebrow">{profile.data.headline}</p>
        <h1>{profile.data.name}</h1>
        <p class="hero-statement">{page.data.blocks.hero_statement}</p>
        {Intro && <div class="hero-intro"><Intro /></div>}
        <div class="actions">
          {hasPage('casework') && <a class="button button-primary" href="/casework/">Explore my work <span aria-hidden="true">↗</span></a>}
          {hasPage('about') && <a class="text-link" href="/about/">Professional background <span aria-hidden="true">→</span></a>}
        </div>
      </div>
      <Portrait profile={profile} />
    </section>
    {experience.length > 0 && <div class="container experience-strip">
      <span class="eyebrow">{page.data.blocks.experience_label}</span>
      <ul>{experience.map(({ data }) => <li>{data.blocks.organization_short ?? data.organization}</li>)}</ul>
    </div>}
    {expertise.length > 0 && <section class="container home-section">
      <div class="section-heading"><div><p class="eyebrow">Areas of focus</p><h2>{page.data.blocks.expertise_heading}</h2></div>
        {hasPage('expertise') && <a class="text-link" href="/expertise/">All areas of expertise <span aria-hidden="true">→</span></a>}
      </div>
      <div class="expertise-grid">{expertise.map((entry, index) => <article class="expertise-preview">
        <span class="section-number">{String(index + 1).padStart(2, '0')}</span>
        <h3>{hasPage('expertise') ? <a href={`/expertise/#${entry.id}`}>{entry.data.title}</a> : entry.data.title}</h3>
        <p>{entry.data.description_short}</p>
      </article>)}</div>
    </section>}
    {projects.length > 0 && <section class="featured-work"><div class="container featured-inner">
      <div><p class="eyebrow">Selected work</p><h2>{page.data.blocks.project_heading}</h2></div>
      <div class="featured-projects">{projects.map((entry) => <article>
        <p class="project-role">{entry.data.contribution}</p>
        <h3>{entry.data.title}</h3><p>{entry.data.description_short}</p>
        {hasPage('casework') && <a class="text-link" href={`/casework/#${entry.id}`}>Read about this work <span aria-hidden="true">→</span></a>}
      </article>)}</div>
    </div></section>}
    {contact && <section class="container contact-band">
      <div><p class="eyebrow">Professional enquiries</p><h2>{page.data.blocks.contact_heading}</h2><p>{page.data.blocks.contact_description}</p></div>
      <a class="button button-primary" href={contact.url}>{contact.label} <span aria-hidden="true">↗</span></a>
    </section>}
  </> : <section class="container page-intro"><p class="eyebrow">Reymundo Gómez</p><h1>Site in preparation</h1><p>Content will appear here when it is ready for publication.</p></section>}
</SiteLayout>
