---
import type { CollectionEntry } from 'astro:content';
import ActivityCard from './ActivityCard.astro';
import { selected } from '../lib/content';
import { orderAboutEntries } from '../lib/about';
type Props = { page: CollectionEntry<'pages'>; kind: 'volunteering' | 'memberships' | 'daos' };
const { page, kind } = Astro.props;
const entries = orderAboutEntries(await selected('activities', page.data[kind]));
const labels = { volunteering: 'Volunteer work', memberships: 'Organization memberships', daos: 'DAO participation' };
---
{entries.length > 0 && <section class="container content-section" id={`section-${kind}`} aria-labelledby={`heading-${kind}`}>
  <div class="section-heading"><div>
    <h2 id={`heading-${kind}`}>{page.data.blocks[`${kind}_heading`] ?? labels[kind]}</h2>
    {page.data.blocks[`${kind}_intro`] && <p class="reading-copy">{page.data.blocks[`${kind}_intro`]}</p>}
  </div></div>
  <div class="about-card-grid">{entries.map((entry) => <ActivityCard entry={entry} />)}</div>
</section>}
