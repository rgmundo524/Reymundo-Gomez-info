---
import type { CollectionEntry } from 'astro:content';
import ActivityCard from './ActivityCard.astro';
import { selected } from '../lib/content';
import { orderAboutEntries } from '../lib/about';
type Props = { page: CollectionEntry<'pages'> };
const { page } = Astro.props;
const labels = { memberships: 'Professional Organizations', daos: 'DAOs (Decentralized Autonomous Organization)' };
const groups = await Promise.all(page.data.organization_group_order.map(async (kind) => ({
  kind, entries: orderAboutEntries(await selected('activities', page.data[kind])),
})));
---
{groups.some(({ entries }) => entries.length > 0) && <section class="container content-section" id="section-organizations" aria-labelledby="heading-organizations">
  <div class="section-heading"><div>
    <h2 id="heading-organizations">{page.data.blocks.organizations_heading ?? 'Organizations'}</h2>
    {page.data.blocks.organizations_intro && <p class="reading-copy">{page.data.blocks.organizations_intro}</p>}
  </div></div>
  {groups.filter(({ entries }) => entries.length > 0).map(({ kind, entries }) => <section class="organization-group" id={`section-${kind}`} aria-labelledby={`heading-${kind}`}>
    <h3 id={`heading-${kind}`}>{page.data.blocks[`${kind}_heading`] ?? labels[kind]}</h3>
    {page.data.blocks[`${kind}_intro`] && <p class="reading-copy">{page.data.blocks[`${kind}_intro`]}</p>}
    <div class="about-card-grid">{entries.map((entry) => <ActivityCard entry={entry} grouped />)}</div>
  </section>)}
</section>}
