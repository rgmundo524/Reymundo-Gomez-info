---
import { render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { skillLevels } from '../lib/about';
type Props = { entry: CollectionEntry<'skills'>; symbols: 'dots' | 'stars' };
const { entry, symbols } = Astro.props;
const { Content } = await render(entry);
const { proficiency } = entry.data;
const rating = proficiency === null ? 'Not yet rated' : `${proficiency}/5 · ${skillLevels[proficiency - 1]}`;
const ratingText = proficiency === null ? rating : `${proficiency} of 5, ${skillLevels[proficiency - 1]}, self-assessed`;
---
<article class="about-card skill-card" id={`skill-${entry.id}`}>
  <div class="about-card-heading">
    <Icon class="about-card-icon" name={`lucide:${entry.data.icon}`} aria-hidden="true" />
    <h4 id={`skill-${entry.id}-title`}>{entry.data.title}</h4>
  </div>
  {entry.data.content_kind === 'example' && <p class="example-label">Example skill · illustrative rating</p>}
  <p>{entry.data.description_short}</p>
  <div class="skill-rating">
    {proficiency !== null && <meter class="sr-only" min="0" max="5" value={proficiency} aria-labelledby={`skill-${entry.id}-title`} aria-valuetext={ratingText}>{ratingText}</meter>}
    <span class="skill-symbols" aria-hidden="true">
      {Array.from({ length: 5 }, (_, index) => <Icon is:inline name={symbols === 'stars' ? 'lucide:star' : 'lucide:circle'} class:list={['skill-symbol', { 'is-filled': proficiency !== null && index < proficiency }]} />)}
    </span>
    <span class="skill-rating-label" aria-hidden={proficiency !== null ? 'true' : undefined}>{rating}</span>
  </div>
  {entry.data.assessed_on && <p class="meta">Self-assessed <time datetime={entry.data.assessed_on}>{entry.data.assessed_on}</time></p>}
  <details><summary>How I use it</summary><div class="prose"><Content /></div></details>
  {entry.data.links.length > 0 && <ul class="links">{entry.data.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}</ul>}
</article>
