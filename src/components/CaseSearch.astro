---
import { getCollection, type CollectionEntry } from 'astro:content';
import { includeDrafts } from '../lib/content';
import { eligibleCases } from '../lib/cases';
type Props = { charts: CollectionEntry<'charts'>[] };
const cases = eligibleCases(Astro.props.charts, await getCollection('cases'), includeDrafts);
---
{cases.length > 0 && <section class="case-search" id="case-search" data-case-search aria-label="Case search">
  <p class="meta" data-case-search-status role="status" hidden></p>
  <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <pagefind-config instance="cases" bundle-path="/pagefind/" faceted preload></pagefind-config>
  <pagefind-input instance="cases" placeholder="Search case summaries…"></pagefind-input>
  <div class="case-search-filters">
    {['Dataset', 'Investigation', 'Category', 'Network', 'Status'].map((filter) => <pagefind-filter-dropdown instance="cases" filter={filter} label={filter} {...(['Dataset', 'Investigation', 'Category'].includes(filter) ? { 'single-select': '', 'show-empty': '' } : {})}></pagefind-filter-dropdown>)}
  </div>
  <div data-case-search-selection hidden>
    <p class="case-search-path" data-case-search-path aria-live="polite" hidden></p>
    <div class="case-visual-controls"><button type="button" data-case-search-reset>Reset search and filters</button></div>
  </div>
  <div data-case-search-output hidden inert>
    <pagefind-summary instance="cases"></pagefind-summary>
    <pagefind-results id="case-search-results" instance="cases" hide-sub-results></pagefind-results>
  </div>
  <noscript><p>Search requires JavaScript. You can browse every case using the charts and case lists below.</p></noscript>
</section>}
