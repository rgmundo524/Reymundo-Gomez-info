---
import type { CollectionEntry } from 'astro:content';
import ContentEntry from './ContentEntry.astro';
import { groupCredentials } from '../lib/credentials';
type Props = { entries: CollectionEntry<'credentials'>[]; issuerOrder?: string[] };
const groups = groupCredentials(Astro.props.entries, Astro.props.issuerOrder);
---
<nav class="credential-issuer-nav" aria-label="Credential issuers">
  {groups.map((group) => <a href={`#${group.id}`}>{group.issuer}<span>{group.entries.length}</span></a>)}
</nav>
<div class="credential-groups">
  {groups.map((group) => <section class="credential-group" aria-labelledby={group.id}>
    <header class="credential-group-heading"><h3 id={group.id}>{group.issuer}</h3><span>{group.entries.length} {group.entries.length === 1 ? 'credential' : 'credentials'}</span></header>
    <div class="entry-list collection-credentials">{group.entries.map((entry) => <ContentEntry entry={entry} grouped />)}</div>
  </section>)}
</div>
