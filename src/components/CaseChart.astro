---
import { render, type CollectionEntry } from 'astro:content';
import { formatShare } from '../lib/charts';
import type { CasePieData } from '../lib/case-visuals';

type Props = { entry: CollectionEntry<'charts'>; visual: CasePieData };
const { entry, visual } = Astro.props;
const { kind, total } = visual;
const id = `case-pie-${kind}-${visual.id}`;
const { Content } = await render(entry);
---

<figure class="case-chart" data-case-visual="pie" aria-labelledby={`${id}-title`}>
  <figcaption>
    <h3 id={`${id}-title`}>{visual.title}</h3>
    <p class="chart-description">{entry.data.description_short}</p>
    <p class="chart-hint">Select a category to see its subcategories. Select a smaller slice to return to the overview.</p>
    <p class="chart-total">{total.toLocaleString('en-US')} {kind === 'example' ? 'example cases' : 'recorded cases'}</p>
  </figcaption>
  {total > 0 ? <div data-visual-panel hidden>
    <div class="case-visual-controls" role="group" aria-label="Pie chart breakdown">
      <button type="button" data-visual-action="pie-reset" aria-controls={id}>All categories</button>
      {visual.categories.filter(({ count }) => count > 0).map((category) => <button type="button" data-visual-action={`pie-category:${category.id}`} aria-pressed="false" aria-controls={id}>{category.label}</button>)}
    </div>
    <div id={id} class="case-pie-canvas" data-visual-host role="group" aria-labelledby={`${id}-title`} aria-describedby={`${id}-view`}></div>
    <p class="chart-hint" id={`${id}-view`} data-pie-view role="status">Showing all categories. Slice percentages use the {total} cases in this chart.</p>
  </div> : <p class="chart-hint">The pie chart will appear as case records are added.</p>}
  <p class="chart-hint" data-visual-status role="status" hidden></p>
      <table class="chart-legend">
        <caption>Counts and shares within {visual.title.toLowerCase()}</caption>
        <thead><tr><th scope="col">Case type</th><th scope="col">Cases</th><th scope="col">Share</th></tr></thead>
        <tbody>
          {visual.categories.map((category) => <tr>
            <th scope="row"><a class="category-link" href={category.url}><span class="swatch case-category-color" style={`--case-light:${category.light};--case-dark:${category.dark}`} aria-hidden="true"></span>{category.label}</a>
              {category.subcategories.length > 0 && <details class="subcategory-list"><summary>Subcategories</summary><ul>
                {category.subcategories.map((subcategory) => <li><a href={subcategory.url}>{subcategory.label}</a><span>{subcategory.count} · {formatShare(subcategory.percentage)}</span></li>)}
              </ul></details>}
            </th>
            <td>{category.count.toLocaleString('en-US')}</td>
            <td>{total > 0 ? formatShare(category.percentage) : '—'}</td>
          </tr>)}
        </tbody>
        <tfoot><tr><th scope="row">Total</th><td>{total.toLocaleString('en-US')}</td><td>{total > 0 ? '100%' : '—'}</td></tr></tfoot>
      </table>
      <div class="chart-caption"><Content /></div>
  {total > 0 && <script is:inline type="application/json" data-visual-data set:html={JSON.stringify(visual).replace(/</g, '\\u003c')}></script>}
</figure>

<style>
  .case-chart { margin: 0; padding: 1.75rem; border: 1px solid var(--line); border-radius: .25rem; background: transparent; min-width: 0; }
  h3 { color: var(--ink); font-family: var(--serif); font-weight: 400; font-size: 2rem; }
  .chart-description { color: var(--muted); font-size: .95rem; margin: .75rem 0; }
  .chart-total { color: var(--ink); font-size: 1.1rem; font-weight: 600; }
  .chart-hint { color: var(--muted); font-size: .875rem; }
  .category-link { display: inline-block; padding: .3rem 0; color: var(--accent); text-decoration-thickness: 1px; }
  .chart-legend { width: 100%; border-collapse: collapse; font-size: .9375rem; line-height: 1.5; font-variant-numeric: tabular-nums; }
  caption { text-align: left; color: var(--muted); font-size: .875rem; padding-block: .5rem; }
  th, td { padding: .55rem .25rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { text-align: left; font-weight: 500; }
  th:first-child { padding-left: 0; }
  thead th { font-size: .875rem; color: var(--muted); font-weight: 600; }
  td, thead th:not(:first-child) { text-align: right; white-space: nowrap; }
  tfoot th, tfoot td { font-weight: 650; border: 0; }
  .swatch { display: inline-block; width: .65rem; height: .65rem; margin-right: .45rem; border: 1px solid #0002; border-radius: 2px; }
  .chart-caption { color: var(--muted); font-size: .875rem; }
  .chart-caption :global(p:last-child) { margin-bottom: 0; }
  .subcategory-list { font-size: .875rem; font-weight: 400; color: var(--muted); }
  .subcategory-list summary { cursor: pointer; padding-block: .4rem; }
  .subcategory-list ul { padding-left: 1rem; margin: .25rem 0 .5rem; }
  .subcategory-list li { margin-block: .5rem; }
  .subcategory-list span { display: block; font-variant-numeric: tabular-nums; }
  @media (max-width: 380px) { .case-chart { padding: 1rem; } .chart-legend { font-size: .875rem; } }
</style>
