---
import { render, type CollectionEntry } from 'astro:content';
import { formatMonth, formatPeriods } from '../lib/content';
import { isCurrentPosition } from '../lib/experience';
import type { ImageMetadata } from 'astro';

type Props = {
  entry: CollectionEntry<Exclude<keyof typeof import('../content.config').collections, 'pages' | 'profile' | 'contacts' | 'charts' | 'cases' | 'articles'>>;
  expanded?: boolean;
  grouped?: boolean;
};
const { entry, expanded = false, grouped = false } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const title = 'role' in data ? data.role : 'title' in data ? data.title : 'name' in data ? data.name : data.program;
const Heading = grouped ? 'h4' : 'h3';
const badge = entry.collection === 'credentials' ? entry.data.badge : undefined;
const badgeFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/credentials/*.{png,jpg,jpeg,webp,svg}');
const badgeLoader = badge ? badgeFiles[`../assets/credentials/${badge.image}`] : undefined;
if (badge && !badgeLoader) throw new Error(`Missing credential badge: src/assets/credentials/${badge.image}`);
const badgeImage = badgeLoader ? (await badgeLoader()).default : undefined;
const credentialLinks = entry.collection === 'credentials' ? [
  ...(entry.data.course_url ? [{ label: 'Training program', url: entry.data.course_url }] : []),
  ...(entry.data.verification_url ? [{ label: 'Verify credential', url: entry.data.verification_url }] : []),
] : [];
const links = [...credentialLinks, ...data.links].filter((link, index, items) => items.findIndex((item) => item.url === link.url) === index);
---
<article class="content-entry" id={entry.id} tabindex="-1">
  <header>
    {badge && badgeImage && <img class="credential-badge" src={badgeImage.src} width={badgeImage.width} height={badgeImage.height} alt={badge.alt} loading="lazy" decoding="async" />}
    {entry.collection === 'experience' && <p class="meta">{formatPeriods(entry.data.periods)}{isCurrentPosition(entry) ? `${entry.data.periods.length ? ' · ' : ''}Current role` : ''}</p>}
    <Heading>{title}</Heading>
    {entry.collection === 'experience' && <p class="entry-organization">{entry.data.organization}</p>}
    {entry.collection === 'credentials' && <p class="meta">{!grouped && `${entry.data.issuer} · `}{entry.data.issued_year} · {entry.data.credential_type}</p>}
    {entry.collection === 'education' && <p class="meta">{entry.data.institution} · {formatMonth(entry.data.start)} to {entry.data.end ? formatMonth(entry.data.end) : 'Present'}{entry.data.credential_type === 'attendance' ? ' · Attendance' : entry.data.completion_status === 'completed' ? '' : ' · Studies'}</p>}
    {entry.collection === 'projects' && <p class="meta">{entry.data.contribution}</p>}
  </header>
  <p>{data.description_short}</p>
  {entry.collection === 'experience' && entry.data.highlights.length > 0 && <ul>{entry.data.highlights.map((highlight) => <li id={`${entry.id}-${highlight.id}`}>{highlight.text}</li>)}</ul>}
  {data.blocks.litigation_relevance && <p class="callout">{data.blocks.litigation_relevance}</p>}
  {expanded ? <div class="prose"><Content /></div> : <details><summary>Read more</summary><div class="prose"><Content /></div></details>}
  {links.length > 0 && <ul class="links">{links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}</ul>}
</article>
