---
import { getCollection, type CollectionEntry } from 'astro:content';
import { includeDrafts } from '../lib/content';
import { articleDate, visibleArticles } from '../lib/articles';
import { readable } from '../lib/cases';
import { Icon } from 'astro-icon/components';
type Props = { page: CollectionEntry<'pages'> };
const { page } = Astro.props;
const articles = visibleArticles(await getCollection('articles'), includeDrafts);
---
{articles.length > 0 && <section class="article-group" aria-labelledby="heading-my-writing">
  <h2 id="heading-my-writing">{page.data.blocks.writing_heading ?? 'My writing'}</h2>
  <div class="article-list">
  {articles.map(({ id, data }) => <article class="article-preview">
    <div class="meta">{data.publication_status === 'draft' && <span>Draft · </span>}{data.published_on ? <time datetime={data.published_on}>{articleDate(data.published_on)}</time> : <span>Unpublished</span>}</div>
    <h3><a href={`/articles/${id}/`}>{data.title}</a></h3>
    <p>{data.description_short}</p>
    {data.tags.length > 0 && <ul class="tag-list" aria-label="Topics">{data.tags.map((tag) => <li>{readable(tag)}</li>)}</ul>}
    <a class="text-link" href={`/articles/${id}/`}>Read article <Icon name="lucide:arrow-right" aria-hidden="true" /><span class="sr-only">: {data.title}</span></a>
  </article>)}
</div></section>}
{articles.length === 0 && <p>Articles will appear here as they are published.</p>}
