---
import { getCollection, type CollectionEntry } from 'astro:content';
import CaseDataset from './CaseDataset.astro';
import { eligibleCases } from '../lib/cases';
import { includeDrafts } from '../lib/content';
type Props = { charts: CollectionEntry<'charts'>[] };
const { charts } = Astro.props;
const studies = eligibleCases(charts, await getCollection('cases'), includeDrafts);
const actual = studies.filter(({ data }) => data.content_kind === 'case_study');
const examples = studies.filter(({ data }) => data.content_kind === 'example');
---
{actual.length > 0 || !includeDrafts || !examples.length ? <CaseDataset charts={charts} studies={actual} kind="case_study" /> : <CaseDataset charts={charts} studies={examples} kind="example" />}
{actual.length > 0 && examples.length > 0 && <details class="example-dataset"><summary>Explore the example dataset ({examples.length} records)</summary><CaseDataset charts={charts} studies={examples} kind="example" /></details>}
