---
import type { CollectionEntry } from 'astro:content';
import { formatMonth } from '../lib/dates';
import { isCurrentPosition } from '../lib/experience';
import { careerTimeline, type TimelineSettings } from '../lib/career-timeline';
type Props = { entries: CollectionEntry<'experience'>[]; settings: TimelineSettings };
const { entries, settings } = Astro.props;
const { undated, ...timeline } = careerTimeline(entries, settings);
const lastMonth = new Date(timeline.to - 1).toISOString().slice(0, 7);
---
<figure class="career-timeline" data-career-timeline aria-labelledby="career-timeline-title">
  <figcaption>
    <div><h3 id="career-timeline-title">Roles over time</h3><p id="career-timeline-help">Follow the line through my career. Select a shaded span or a position below to explore the work.</p></div>
    <span class="career-extent">{formatMonth(timeline.start)} to {formatMonth(lastMonth)}</span>
  </figcaption>
  {timeline.spans.length > 0 && <>
    <div class="career-interactive" data-career-interactive hidden>
      <div class="career-toolbar" role="group" aria-label="Timeline navigation">
        <button type="button" data-career-action="earlier" aria-controls="career-chart">Earlier</button>
        <button class="career-zoom" type="button" data-career-action="zoom-in" aria-controls="career-chart" aria-label="Zoom in" title="Zoom in"><span aria-hidden="true">+</span></button>
        <button class="career-zoom" type="button" data-career-action="zoom-out" aria-controls="career-chart" aria-label="Zoom out" title="Zoom out"><span aria-hidden="true">−</span></button>
        <button type="button" data-career-action="later" aria-controls="career-chart">Later</button>
        <button type="button" data-career-action="reset" aria-controls="career-chart">Full timeline</button>
      </div>
      <p class="career-window" data-career-window aria-live="polite" aria-atomic="true"></p>
      <div id="career-chart" class="career-chart" data-career-chart role="region" aria-label="Interactive serpentine work history" aria-describedby="career-timeline-help career-timeline-note"></div>
      <p class="career-note" id="career-timeline-note">Hover or focus a span for dates. Drag along the line to zoom on desktop, or use the buttons and slider. Parallel bands show concurrent roles; breaks remain visible.</p>
    </div>
    <p class="career-note" data-career-status role="status" hidden>Loading the interactive timeline. You can explore the positions below.</p>
    <ol class="career-roles" aria-label="Positions and employment dates">
      {timeline.roles.map((role) => <li><a class="career-role-link" href={`#${role.id}`} data-position-link style={`--role-light:${role.light};--role-dark:${role.dark}`}>
        <span class="career-swatch" aria-hidden="true"></span>
        <span><strong>{role.label}</strong><span>{role.role}</span><span class="career-dates">{role.dates}</span></span>
      </a></li>)}
    </ol>
    <p class="career-note">Dates are recorded by month. Each end month is included. Current roles extend through {formatMonth(timeline.asOf)}.</p>
    <script is:inline type="application/json" data-career-data set:html={JSON.stringify(timeline).replace(/</g, '\\u003c')}></script>
  </>}
  {undated.length > 0 && <div class="career-undated">
    <p>Start date not yet recorded</p>
    <ul>{undated.map((entry) => <li><a href={`#${entry.id}`} data-position-link><strong>{entry.data.organization}</strong> · {entry.data.role}</a>{isCurrentPosition(entry) && <span class="timeline-current">Current role</span>}</li>)}</ul>
  </div>}
</figure>
<script>
  import { mountCareerTimelines } from '../scripts/work-history';
  const cleanup = mountCareerTimelines();
  if (import.meta.hot) import.meta.hot.dispose(cleanup);
</script>
