---
import { render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { articleDate } from '../lib/articles';
import { readable } from '../lib/cases';
type Props = { entry: CollectionEntry<'reading'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const { source } = entry.data;
const labels = { article: 'Article', blog: 'Blog post', report: 'Report' };
---
<article class="article-preview reading-preview" id={`reading-${entry.id}`}>
  <div class="meta"><span>{labels[entry.data.reading_type]}</span> · <span>{source.publisher}</span>{source.author && <span> · {source.author}</span>}</div>
  {entry.data.content_kind === 'example' && <p class="reading-example">Reading list example · awaiting review</p>}
  <h3><a href={source.url}>{entry.data.title}<Icon name="lucide:arrow-up-right" aria-hidden="true" /></a></h3>
  <p>{entry.data.description_short}</p>
  {(source.published_on || entry.data.added_on) && <p class="meta">
    {source.published_on && <span>Source published <time datetime={source.published_on}>{articleDate(source.published_on)}</time></span>}
    {source.published_on && entry.data.added_on && ' · '}
    {entry.data.added_on && <span>Added <time datetime={entry.data.added_on}>{articleDate(entry.data.added_on)}</time></span>}
  </p>}
  {entry.data.tags.length > 0 && <ul class="tag-list" aria-label="Topics">{entry.data.tags.map((tag) => <li>{readable(tag)}</li>)}</ul>}
  <details><summary>Reading notes<span class="sr-only"> for {entry.data.title}</span></summary><div class="prose"><Content /></div></details>
  <a class="text-link" href={source.url}>Read at {source.publisher}<Icon name="lucide:arrow-up-right" aria-hidden="true" /><span class="sr-only">: {entry.data.title}</span></a>
  {entry.data.links.length > 0 && <ul class="links">{entry.data.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}</ul>}
</article>
