---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { includeDrafts, isVisible, pageProfile } from '../lib/content';
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { navigationIcons } from '../lib/icons';
import { openGraphPath } from '../lib/open-graph';
import ParticleBackground from '../components/ParticleBackground.astro';

type Props = {
  title: string;
  description: string;
  profile?: CollectionEntry<'profile'>;
  article?: { published_on: string | null; updated_on: string | null };
};
const { title, description } = Astro.props;
const profile = Astro.props.profile ?? await pageProfile(await getEntry('pages', 'home'));
const visiblePages = await getCollection('pages', isVisible);
const contactPage = visiblePages.find(({ id }) => id === 'contact');
const navigation = visiblePages.filter(({ id, data }) => id !== 'contact' && data.navigation)
  .sort((a, b) => a.data.navigation!.order - b.data.navigation!.order || a.id.localeCompare(b.id))
  .map(({ id, data }) => ({ id, label: data.navigation!.label, url: id === 'home' ? '/' : `/${id}/` }));
const name = profile?.data.name ?? 'Reymundo Gómez';
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site!);
const socialImage = new URL(openGraphPath(currentPath), Astro.site!);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={name} />
    <meta property="og:type" content={Astro.props.article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}. ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${title}. ${description}`} />
    {Astro.props.article?.published_on && <meta property="article:published_time" content={`${Astro.props.article.published_on}T00:00:00Z`} />}
    {Astro.props.article?.updated_on && <meta property="article:modified_time" content={`${Astro.props.article.updated_on}T00:00:00Z`} />}
    <title>{title}</title>
  </head>
  <body>
    <ParticleBackground />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/" aria-label={`${name}, home`}>
          <span class="monogram" aria-hidden="true">RG</span>
          <span>{name}</span>
        </a>
        {navigation.length > 0 && <nav class="site-nav" aria-label="Main navigation">
          {navigation.map(({ id, label, url }) => <a href={url} aria-current={(id === 'home' ? currentPath === '/' : currentPath.startsWith(url)) || (id === 'casework' && currentPath.startsWith('/investigations/')) ? 'page' : undefined}>{navigationIcons[id] && <Icon name={navigationIcons[id]} aria-hidden="true" />}<span>{label}</span></a>)}
        </nav>}
        <div class="header-actions">
          <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="true" title="Switch to light mode" hidden><Icon name="lucide:moon" class="theme-moon" aria-hidden="true" /><Icon name="lucide:sun" class="theme-sun" aria-hidden="true" /></button>
          {contactPage && <a class="button button-primary header-contact" href="/contact/" aria-current={currentPath.startsWith('/contact/') ? 'page' : undefined}>Contact</a>}
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main">
        <div><a class="footer-name" href="/">{name}</a><p>Blockchain investigations &amp; expert witness work</p></div>
        {contactPage && <div class="footer-contact"><span>Professional enquiries</span><a href="/contact/">Contact me</a></div>}
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {name}</span>
        {includeDrafts && <span>Development preview · Draft content included</span>}
      </div>
    </footer>
    <script>
      // Keep anchors and keyboard focus below the sticky header as its links wrap.
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        const updateHeaderHeight = () => {
          document.documentElement.style.setProperty('--site-header-height', `${Math.ceil(header.getBoundingClientRect().height)}px`);
        };
        updateHeaderHeight();
        const headerObserver = new ResizeObserver(updateHeaderHeight);
        headerObserver.observe(header);
        import.meta.hot?.dispose(() => headerObserver.disconnect());
      }
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      function applyTheme(dark: boolean) {
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        toggle?.setAttribute('aria-pressed', String(dark));
        toggle?.setAttribute('title', dark ? 'Switch to light mode' : 'Switch to dark mode');
      }
      if (toggle) {
        toggle.hidden = false;
        applyTheme(true);
        toggle.addEventListener('click', () => {
          const dark = document.documentElement.dataset.theme !== 'dark';
          applyTheme(dark);
        });
        window.addEventListener('pageshow', (event) => { if (event.persisted) applyTheme(true); });
      }
    </script>
  </body>
</html>
